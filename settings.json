            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checando documentos de planejamento (iniciar-projeto)..."
          },
          {
            "type": "command",
            "command": "\"C:/Users/bruno.krieger/AppData/Local/Programs/Python/Python312/python.exe\" \"C:/Users/bruno.krieger/.claude/hooks/check_style_prohibitions.py\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checando proibicoes de estilo (iniciar-projeto)..."
          }
        ]
